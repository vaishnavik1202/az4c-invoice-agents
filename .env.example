# Copy this file to .env and fill in your own keys. Never commit .env.
GROQ_API_KEY=
# Main models (each falls back to a chain of other Groq models, see README "Models and why")
GROQ_MODEL=openai/gpt-oss-120b
GROQ_SPECIALIST_MODEL=openai/gpt-oss-20b
# Optional: full comma-separated chains, overriding the defaults
# GROQ_ORCHESTRATOR_MODELS=openai/gpt-oss-120b,llama-3.3-70b-versatile
# GROQ_SPECIALIST_MODELS=openai/gpt-oss-20b,meta-llama/llama-4-scout-17b-16e-instruct
# Optional extra fallback provider
USE_GEMINI=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Folder where the data pack is unzipped (contains data/, docs/, samples/)
DATA_DIR=./data-pack
